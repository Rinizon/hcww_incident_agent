# HCWW Incident Agent environment template.
# Copy this file to .env and replace placeholder values before production use.

# Core service
HCWW_AGENT_HOST=127.0.0.1
HCWW_AGENT_PORT=8787
HCWW_AGENT_DB_PATH=data/agent_state.db
HCWW_AGENT_ENV=development
HCWW_AGENT_SERVICE_NAME=hcww
HCWW_AGENT_ACTOR_EMAIL=incident-agent@hcww.local
HCWW_AGENT_PUBLIC_BASE_URL=https://agent.example.com

# Workflow and admin authentication
TEAMS_WORKFLOW_SHARED_SECRET=replace-with-random-workflow-secret
TEAMS_WORKFLOW_SECRET_HEADER=X-HCWW-Workflow-Secret
BETTERSTACK_WEBHOOK_SHARED_SECRET=
HCWW_ADMIN_SHARED_SECRET=replace-with-random-admin-secret

# Teams posting
TEAMS_POST_MODE=workflow
TEAMS_WEBHOOK_URL=

# Cloudflare cache purge
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
CLOUDFLARE_ZONE_ID=replace-with-cloudflare-zone-id

# Deploy integration
HCWW_DEPLOY_MODE=deploy_hook
HCWW_DEPLOY_BASE_URL=https://deploy.example.com/replace-with-deploy-hook
HCWW_DEPLOY_API_TOKEN=

# Public URL policy and diagnostics
HCWW_ALLOWED_PUBLIC_ORIGINS=https://hcww.net,https://www.hcww.net
HCWW_SMOKE_CHECK_URL=
HCWW_CORE_SMOKE_URLS=
HCWW_SMOKE_CHECK_EXPECTED_TEXT=Hill Country Web Works
HCWW_CONTACT_FORM_EXPECTED_ACTION=
HCWW_DIAGNOSTIC_TIMEOUT_SECONDS=10

# Request and remediation safety
HCWW_MAX_WEBHOOK_BODY_BYTES=65536
HCWW_MAX_REMEDIATION_ATTEMPTS=2
HCWW_MAX_PLAYBOOK_RETRIES=1
HCWW_REMEDIATION_COOLDOWN_SECONDS=300
HCWW_RETENTION_DAYS=90
HCWW_REMEDIATION_DISABLED=false
HCWW_ENABLE_CACHE_PURGE=false
HCWW_ENABLE_REDEPLOY=false
